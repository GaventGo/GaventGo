# Copy this file to .env.local and fill in your real values.
# Supabase values: Project Settings > API in your Supabase dashboard.
# Paystack values: Settings > API Keys & Webhooks in your Paystack dashboard.

# --- Supabase ---

# Safe to expose in the browser (public anon key, protected by RLS).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. Never prefix with NEXT_PUBLIC_, never import in a "use client"
# file, never commit the real value. Used by lib/supabase/admin.ts to settle
# orders from the Paystack webhook/verification flow, where there's no user
# session to check RLS against.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Payments (Paystack) ---

# Server-only secret key — used to initialize/verify transactions and to
# check the webhook signature. Never exposed to the browser. If this is
# unset, checkout still works up through creating a pending order; the
# "Pay with Paystack" step will show a friendly "payment not configured"
# message instead of crashing.
PAYSTACK_SECRET_KEY=

# Used to build the Paystack callback_url. Optional in development — falls
# back to the incoming request's own host if unset. Set this in production
# (e.g. https://gaventgo.app, no trailing slash).
NEXT_PUBLIC_SITE_URL=

# --- Email (Resend) ---

# Server-only. Used to send order/ticket confirmation emails after payment
# settles. If unset, checkout and payment settlement still work exactly as
# before — the confirmation email is best-effort and never blocks or fails
# a payment. Get a key at https://resend.com (free tier is enough to start).
RESEND_API_KEY=

# The "from" address for confirmation emails. Must be a verified domain in
# your Resend account before it will actually send — Resend's own sandbox
# domain (onboarding@resend.dev) works for testing without domain setup.
EMAIL_FROM=GaventGo <onboarding@resend.dev>

# --- Payouts (admin) ---

# Your own email — the only account allowed to view /admin/payouts, the
# private ledger of what's owed to each organizer. Not shown or linked
# anywhere in the app's normal navigation; visit the URL directly. If
# unset, that page refuses everyone.
PLATFORM_ADMIN_EMAIL=

# What percentage of each sale the platform keeps before the rest is owed
# to the organizer. Whole number, e.g. 10 for 10%. Defaults to 0 (organizer
# owed the full amount) if unset.
PLATFORM_FEE_PERCENT=10

# --- Maintenance ---

# Protects /api/cron/expire-orders (releases inventory held by pending
# orders that were never paid). If set, Vercel Cron automatically sends it
# as `Authorization: Bearer <value>` — see vercel.json. Leave unset in local
# dev if you're calling the route by hand; set it before deploying.
CRON_SECRET=

